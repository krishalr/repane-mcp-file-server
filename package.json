{
  "name": "repane-mcp-file-server",
  "version": "1.0.0",
  "description": "A sandboxed **MCP file-server connector** for AI agents: file operations, git-lite tools, and a handoff protocol (`PROJECT_STATE`, `PLAN_LOG`, `CHECKPOINTS`, `DECISIONS`) so multiple agent sessions can share memory on one project. Served over HTTPS through a tunnel and kept alive by a process manager.",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krishalr/repane-mcp-file-server.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/krishalr/repane-mcp-file-server/issues"
  },
  "homepage": "https://github.com/krishalr/repane-mcp-file-server#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
